        "jsCode": "const rows=$json.records||[]; const statuses=rows.map(r=>r.fields['Statut upload']); const pending=statuses.filter(s=>s==='A_UPLOADER').length; const ok=statuses.filter(s=>s==='UPLOADE').length; const errors=statuses.filter(s=>s==='ERREUR').length; const status=pending?'EN_COURS':errors?(ok?'PARTIEL':'ERREUR'):'TERMINE'; const a=$('Restaurer binaire').item.json; return {json:{gmailId:a.gmailId,mailRecordId:a.mailRecordId,status,isFinal:pending===0,detail:errors?errors+' fichier(s) en erreur':''}};"
