# Copier ce fichier vers .env puis remplacer toutes les valeurs CHANGE_ME.
N8N_VERSION=2.6.4
N8N_PORT=5678
GENERIC_TIMEZONE=Europe/Paris
TZ=Europe/Paris
N8N_ENCRYPTION_KEY=CHANGE_ME_MINIMUM_32_CHARACTERS
N8N_USER_FOLDER=/home/node/.n8n
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Identifiants Airtable (utiliser les IDs tbl..., pas les noms).
AIRTABLE_BASE_ID=app_CHANGE_ME
AIRTABLE_CLIENTS_TABLE_ID=tbl_CHANGE_ME
AIRTABLE_MAILS_TABLE_ID=tbl_CHANGE_ME
AIRTABLE_FILES_TABLE_ID=tbl_CHANGE_ME

# Dossier Drive TechDistri_Demo/Clients et libellés Gmail créés pendant l'installation.
GOOGLE_DRIVE_CLIENTS_FOLDER_ID=CHANGE_ME
GMAIL_LABEL_DONE_ID=CHANGE_ME
GMAIL_LABEL_ERROR_ID=CHANGE_ME
